# 复制成 .env 后按实际环境填写：cp .env.example .env
# docker compose 会自动读取同目录下的 .env，变量会覆盖 compose 里的默认值。

# 宿主机映射端口（只有本机 Nginx 会用到）。被占用时改这里。
HOST_PORT=18090

# ---------- 数据库 ----------
# MySQL 装在宿主机：保持 host.docker.internal
# MySQL 是 Docker 容器：填那个容器名，并让它和 bbb-server 在同一个网络
# 用本 compose 里的 bbb-mysql：填 bbb-mysql，并加 --profile with-mysql 启动
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=bbb
DB_USER=bbb
DB_PASSWORD=bbb123456

# 只有启用 bbb-mysql 时才需要
MYSQL_ROOT_PASSWORD=change-this-root-password

# 启用内置 MySQL（DB_HOST=bbb-mysql）时，把下面这行注释去掉，
# 之后 docker compose 的所有子命令都不用再手写 --profile with-mysql。
# 用 docker compose config --services 验证：输出里有 bbb-mysql 才算生效。
# COMPOSE_PROFILES=with-mysql

# 启动时最多等数据库多少秒（MySQL 首次初始化需要 30~60s）。填 0 表示不等。
DB_WAIT_TIMEOUT=120

# ---------- 地图（首页自动定位） ----------
# 腾讯位置服务 WebService key。不填也能启动，只是自动定位会退回手动选点。
TENCENT_MAP_KEY=

# 说明：JVM 内存不在这里配，直接改 docker-compose.yml 里的 JAVA_OPTS
# （服务器内存小就压到 -Xmx384m，充裕可给 1g）
